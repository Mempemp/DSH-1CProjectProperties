{
  "name": "dsh-1c-project-properties",
  "version": "0.11.0",
  "description": "Параметры 1С в разрезе проекта и движок rlm: визард добавления проекта, проверка подключения внешним соединением, выгрузка/загрузка конфигурации, правила 1С, справка по платформе, MCP-сервер анализа кода rlm-tools-bsl",
  "keywords": [
    "1c",
    "1c-enterprise",
    "bsl",
    "code-analysis",
    "deepseek-harness",
    "dsh",
    "mcp",
    "plugin",
    "project",
    "rlm",
    "settings"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "cordis": "^4.0.0-rc.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
