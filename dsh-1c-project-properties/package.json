{
  "name": "dsh-1c-project-properties",
  "version": "0.3.0",
  "description": "Параметры 1С в разрезе проекта для DeepSeek Harness: вкладка в Settings со списком проектов, значения — в файле .dsh/1c-project.json внутри папки проекта, кнопка выгрузки конфигурации в XML-файлы.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "1c",
    "1c-enterprise",
    "settings",
    "project"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "cordis": "^4.0.0-rc.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
